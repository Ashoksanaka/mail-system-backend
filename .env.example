# ─── Django ─────────────────────────────────────────
# Public hostname served by Caddy (TLS certificate subject).
# No custom DNS needed: use nip.io — replace dots in the VM public IP with dashes.
# Example: public IP 13.60.91.88 → DOMAIN=13-60-91-88.nip.io
DOMAIN=13-60-91-88.nip.io
DJANGO_SECRET_KEY=your-secret-key-here
# Set False in production on the AWS VM.
DJANGO_DEBUG=True
# Include the Caddy public hostname (no scheme).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,13-60-91-88.nip.io
# Optional: redirect plain HTTP→HTTPS at Django (usually leave False; Caddy terminates TLS).
SECURE_SSL_REDIRECT=False

# ─── PostgreSQL ──────────────────────────────────────
DB_NAME=mail_db
DB_USER=mail_user
DB_PASSWORD=mail_password
DB_HOST=db
DB_PORT=5432
# Celery runs with network_mode: host and overrides DB_HOST/REDIS_URL to 127.0.0.1

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Per-user SMTP encryption ────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Users set their own Gmail app password in the Settings UI.
# Sender email is locked to each user's Clerk signup address.
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key

# ─── Clerk (backend only) ────────────────────────────
# From Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Optional PEM public key for networkless JWT verification
# (Dashboard → API Keys → Show JWT public key → PEM Public Key)
# Keep newlines as \n when storing in a single-line .env value
CLERK_JWT_KEY=
# Comma-separated frontend origins allowed in the token azp claim
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://mailblasto.vercel.app

# ─── Cross-origin (HTTPS Vercel ↔ HTTPS/WSS AWS) ─────
# Browser origins allowed for REST (CORS). Must use https:// for Vercel.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://mailblasto.vercel.app
# Browser Origin headers allowed for WebSockets (scheme + host).
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://mailblasto.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://mailblasto.vercel.app

# ─── Frontend (reference / docker build args) ────────
# Production Vercel values must be HTTPS / WSS (never plain HTTP to the VM IP).
VITE_API_BASE_URL=https://13-60-91-88.nip.io
VITE_WS_BASE_URL=wss://13-60-91-88.nip.io
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
